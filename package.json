{
    "name": "indygl",
    "author": "Mark-André Hopf <mhopf@mark13.org>",
    "license": "AGPL-3.0",
    "version": "0.0.0",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/markandre13/indygl.git"
    },
    "scripts": {
        "build": "tsgo && vite build",
        "start": "tsgo && concurrently --names tsgo,vite 'npm run tsgo' 'npm run vite'",
        "test": "tsgo && concurrently --killothers --names tsgo,vite 'npm run tsgo' 'npm run vitest'",
        "tsgo": "tsgo --watch --preserveWatchOutput",
        "vite": "NO_COLOR=true vite --mode production --clearScreen false --open",
        "vitest": "vitest --clearScreen false --watch js/spec",
        "preview": "tsgo && vite preview --open",
        "update": "npx npm-check-updates -u && npm install"
    },
    "devDependencies": {
        "@types/earcut": "^3.0.0",
        "@typescript/native-preview": "^7.0.0-dev.20260512.1",
        "@vitest/browser-playwright": "^4.1.6",
        "@webgpu/types": "^0.1.70",
        "concurrently": "^9.2.1",
        "vite": "^8.0.12",
        "vite-plugin-solid": "^2.11.12",
        "vitest": "^4.1.6"
    },
    "dependencies": {
        "bignumber.js": "^11.1.1",
        "earcut": "^3.0.2",
        "gl-matrix": "^3.4.4",
        "toad.js": "^0.3.5"
    }
}
