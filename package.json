{
    "name": "indygl",
    "author": "Mark-André Hopf <mhopf@mark13.org>",
    "license": "AGPL-3.0",
    "version": "0.0.0",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/markandre13/indygl.git"
    },
    "scripts": {
        "build": "npm run wgsl && tsgo && vite build",
        "start": "npm run wgsl && tsgo && concurrently --killothers --names tsgo,vite 'npm run tsgo:watch' 'npm run vite'",
        "test": "rm -rf js && npm run wgsl && npm run tsgo && npm run vitest",
        "test:watch": "rm -rf js && npm run wgsl && tsgo && concurrently --killothers --names tsgo,vite 'npm run tsgo:watch' 'npm run vitest:watch'",
        "wgsl": "mkdir -p js/src/gl/shaders && ln -f src/gl/shaders/*wgsl js/src/gl/shaders",
        "tsgo": "tsgo",
        "tsgo:watch": "tsgo --watch --preserveWatchOutput",
        "vite": "NO_COLOR=true vite --mode production --clearScreen false --open",
        "vitest": "vitest --run js/spec",
        "vitest:watch": "vitest --clearScreen false --watch js/spec",
        "preview": "npm run wgsl && tsgo && vite preview --open",
        "update": "npx npm-check-updates -u && npm install"
    },
    "devDependencies": {
        "@types/chai-almost": "^1.0.3",
        "@types/earcut": "^3.0.0",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "@vitest/browser-playwright": "^4.1.10",
        "@webgpu/types": "^0.1.71",
        "chai-almost": "^1.0.1",
        "clickclick.js": "^0.0.1",
        "concurrently": "^10.0.4",
        "jsdom": "^30.0.1",
        "vite": "^8.2.1",
        "vite-plugin-glsl": "^1.6.1",
        "vite-plugin-solid": "^2.11.14",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "bignumber.js": "^11.1.5",
        "earcut": "^3.2.3",
        "gl-matrix": "^3.4.4",
        "toad.js": "^0.3.7"
    }
}
